# Inject the API key from a secret manager. Never commit a real value.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
DOUBAO_MODEL=doubao-seed-2.1-turbo

EXAM_REQUEST_TIMEOUT=180
EXAM_STUDENT_WORKERS=3
EXAM_PAGE_WORKERS=2
EXAM_VISUAL_BATCH_ITEMS=4
EXAM_MAX_OUTPUT_TOKENS=32768

# VLM upload copies; source images and output coordinates remain unchanged.
EXAM_UPLOAD_MAX_LONG_EDGE=2300
EXAM_UPLOAD_JPEG_QUALITY=85
